@page
@using Razor.Components
@model Razor.Pages.Movies.DetailsModel

@if (Model.Schedule is not null)
{
    <div class="cd__main">
        <div class="container my-5">
            <div class="row">
                <div class="col-md-5">
                    <div class="main-img">
                        <img class="img-fluid" src="@Model.Schedule.Movie.URL" alt="@Model.Schedule.Movie.Title">
                    </div>
                </div>
                <div class="col-md-7">
                    <div class="main-description px-2">
                        <div class="category text-bold">
                            @Model.Schedule.Movie.Title
                        </div>
                        <div class="product-title text-bold my-3">
                            @Model.Schedule.Movie.Description
                        </div>
                        <div class="product-title text-bold my-3">
                            @Model.Schedule.Cost ₽
                        </div>

                        <div class="product-title text-bold my-3">
                            @Model.Schedule.StartFilm.Hour.ToString("00") : @Model.Schedule.StartFilm.Minute.ToString("00")
                        </div>

                        <div class="row row-cols-4">
                            <form method="get">
                                @for (int i = 0; i < 10; i++)
                                {
                                    <button type="submit" asp-route-i="@i" asp-page-handler="delete" class="btn btn-primary">Удалить</button>
                                }
                            </form>
                        </div>
                        <a class="btn btn-primary" asp-page="./Index">Назад</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

