@page
@using Razor.Components
@using Razor.Pages.Movies
@model IndexModel

<div class="container" style="padding-top: 35px">
    <form method="post">
        <p>Мы показываем фильма с @Model.MinDateMovie по @Model.MaxDateMovie</p>
        <input type="date" asp-for="SearchDateMovie" asp-format="{0:yyyy-MM-ddTHH:mm}" value="@Model.SelectedDateMovie" min="@Model.MinDateMovie" max="@Model.MaxDateMovie">
        <p>
            Поиск фильма
            <input type="text" asp-for="SearchTitleMovie" />
            <input type="submit" />
        </p>
    </form>
    <div class="row row-cols-4">
        @if (Model.SchedulesByMovie is not null)
        {
            foreach (var schedulesByMovie in Model.SchedulesByMovie)
            {
                var schedules = Model.SchedulesByMovie[schedulesByMovie.Key];

                <div class="card gap-3" style="width: 18rem;">
                    <img src="@schedulesByMovie.Key.URL" class="card-img-top" alt="@schedulesByMovie.Key.Title">
                    <div class="card-body">
                        <h5 class="card-title">@schedulesByMovie.Key.Title</h5>
                    </div>
                    <ul class="list-group list-group-flush">
                        @foreach (var schedule in schedules)
                        {
                            <li class="list-group-item">
                                @schedule.StartFilm.Hour.ToString("00") : @schedule.StartFilm.Minute.ToString("00") |
                                @schedule.Cost ₽
                                <a class="btn btn-primary" asp-page="./Details" asp-route-id="@schedule.Id">Купить</a>
                            </li>
                        }
                    </ul>
                </div>
            }
        }
    </div>
</div>